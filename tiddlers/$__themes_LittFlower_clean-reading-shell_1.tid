/*
Clean Reading - shell
Typography, spacing and surfaces for the story river, sidebar, search,
tabs and editor. Structure is left to the stock theme on purpose.
Tune the variables in this first block; everything else follows them.
*/
body.tc-body {
  --lf-ui-font: "JetBrains Mono", "PingFang SC", "Hiragino Sans GB", Menlo, monospace;
  --lf-mono-font: "JetBrains Mono", "PingFang SC", Menlo, Consolas, monospace;

  --lf-measure: 43rem;
  --lf-ui-size: 13.5px;
  --lf-ui-leading: 1.55;

  --lf-paper: #ffffff;
  --lf-page: #faf9f7;
  --lf-ink-strong: #2b2924;
  --lf-ink: #37352f;
  --lf-muted: #6e675d;
  --lf-faint: #a8a29a;
  --lf-line: #ecebe7;
  --lf-line-strong: #e3e0d9;
  --lf-hover: #f5f3ef;
  --lf-accent: #3b6ea8;
  --lf-accent-ink: #2c5580;
  --lf-accent-soft: #f0f4f9;

  --lf-radius: 10px;
  --lf-radius-sm: 6px;
  --lf-pad: 34px;

  background: var(--lf-page);
  color: var(--lf-ink);
  font-family: var(--lf-ui-font);
  font-size: var(--lf-ui-size);
  line-height: var(--lf-ui-leading);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body.tc-body *,
body.tc-body *::before,
body.tc-body *::after {
  box-sizing: border-box;
}

body.tc-body ::selection {
  background: #d6e4f2;
  color: #1f2933;
}

/* ---------- story river: one calm reading column ---------- */

body.tc-body .tc-story-river {
  padding: 36px 24px 42vh;
}

body.tc-body .tc-tiddler-frame {
  background: var(--lf-paper);
  border: 1px solid var(--lf-line);
  border-radius: var(--lf-radius);
  box-shadow: none;
  padding: 30px var(--lf-pad) 34px;
  max-width: calc(var(--lf-measure) + 2 * var(--lf-pad));
  margin: 0 auto 18px;
}

body.tc-body .tc-tiddler-frame:hover {
  border-color: var(--lf-line-strong);
}

/* title block */

body.tc-body .tc-tiddler-title {
  margin-bottom: 2px;
}

body.tc-body .tc-tiddler-title .tc-titlebar,
body.tc-body .tc-titlebar h2 {
  font-family: var(--lf-ui-font);
  font-size: 1.6rem;
  font-weight: 600;
  line-height: 1.32;
  letter-spacing: -0.002em;
  color: var(--lf-ink-strong);
}

body.tc-body .tc-subtitle,
body.tc-body .tc-tiddler-subtitle {
  font-size: 0.78rem;
  color: var(--lf-muted);
  letter-spacing: 0.01em;
}

/* controls recede until you reach for them */

body.tc-body .tc-tiddler-frame .tc-tiddler-controls {
  opacity: 0.28;
  transition: opacity 140ms ease;
}

body.tc-body .tc-tiddler-frame:hover .tc-tiddler-controls,
body.tc-body .tc-tiddler-frame:focus-within .tc-tiddler-controls {
  opacity: 1;
}

body.tc-body .tc-tiddler-controls svg {
  width: 0.95em;
  height: 0.95em;
  fill: var(--lf-muted);
}

body.tc-body .tc-tiddler-controls button:hover svg {
  fill: var(--lf-ink);
}

/* ---------- links ---------- */

body.tc-body a.tc-tiddlylink,
body.tc-body a.tc-tiddlylink-external {
  color: var(--lf-accent);
  font-weight: 400;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 120ms ease, color 120ms ease;
}

body.tc-body a.tc-tiddlylink:hover,
body.tc-body a.tc-tiddlylink-external:hover {
  color: var(--lf-accent-ink);
  border-bottom-color: rgba(59, 110, 168, 0.45);
  background: transparent;
}

body.tc-body a.tc-tiddlylink-missing {
  color: var(--lf-muted);
  font-weight: 400;
  font-style: normal;
  border-bottom: 1px dotted var(--lf-line-strong);
}

body.tc-body .tc-tiddlylink:focus-visible {
  outline: 2px solid rgba(59, 110, 168, 0.5);
  outline-offset: 2px;
  border-radius: 3px;
}

/* ---------- tags ---------- */

body.tc-body .tc-tags-wrapper {
  margin-top: 14px;
}

body.tc-body .tc-tag-label {
  background: #f1efea;
  color: #57514a;
  border: none;
  border-radius: 999px;
  padding: 2px 11px;
  font-size: 0.76rem;
  font-weight: 450;
  line-height: 1.6;
}

body.tc-body .tc-tag-label:hover {
  background: #e7e4dd;
  color: var(--lf-ink);
}

/* ---------- buttons ---------- */

body.tc-body button.tc-btn-invisible {
  border-radius: var(--lf-radius-sm);
  color: var(--lf-muted);
  transition: background 120ms ease, color 120ms ease;
}

body.tc-body button.tc-btn-invisible:hover {
  background: var(--lf-hover);
  color: var(--lf-ink);
}

body.tc-body .tc-page-controls svg {
  width: 1.05em;
  height: 1.05em;
  fill: var(--lf-muted);
}

body.tc-body .tc-page-controls a:hover svg,
body.tc-body .tc-page-controls button:hover svg {
  fill: var(--lf-ink);
}

/* ---------- sidebar ---------- */

body.tc-body .tc-sidebar-scrollable {
  background: transparent;
  padding-top: 18px;
}

body.tc-body .tc-sidebar-header {
  color: var(--lf-muted);
}

body.tc-body .tc-sidebar-header .tc-title,
body.tc-body .tc-site-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--lf-ink-strong);
  text-shadow: none;
  letter-spacing: -0.005em;
}

body.tc-body .tc-site-subtitle {
  font-size: 0.78rem;
  color: var(--lf-faint);
  margin-top: 2px;
}

/* sidebar tabs: text with an underline marker, no boxes */

body.tc-body .tc-sidebar-lists .tc-tab-buttons {
  border-bottom: 1px solid var(--lf-line);
  margin-bottom: 10px;
  display: flex;
  gap: 2px;
  overflow-x: auto;
  scrollbar-width: none;
}

body.tc-body .tc-sidebar-lists .tc-tab-buttons::-webkit-scrollbar {
  display: none;
}

body.tc-body .tc-sidebar-lists .tc-tab-buttons button,
body.tc-body .tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0;
  margin: 0;
  padding: 6px 10px;
  font-size: 0.82rem;
  font-weight: 450;
  color: var(--lf-muted);
  white-space: nowrap;
  transition: color 120ms ease, border-color 120ms ease;
}

body.tc-body .tc-sidebar-lists .tc-tab-buttons button:hover {
  color: var(--lf-ink);
  background: transparent;
}

body.tc-body .tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
  color: var(--lf-ink-strong);
  font-weight: 550;
  border-bottom-color: var(--lf-accent);
}

body.tc-body .tc-sidebar-lists .tc-tab-divider {
  display: none;
}

body.tc-body .tc-sidebar-lists a.tc-tiddlylink {
  color: #57514a;
  font-weight: 400;
  border-bottom: none;
}

body.tc-body .tc-sidebar-lists a.tc-tiddlylink:hover {
  color: var(--lf-ink-strong);
  border-bottom: none;
}

body.tc-body .tc-sidebar-lists .tc-menu-list-item {
  padding: 1px 0;
  line-height: 1.7;
}

body.tc-body .tc-sidebar-lists .tc-menu-list-subitem a.tc-tiddlylink {
  font-size: 0.86rem;
  color: var(--lf-muted);
}

body.tc-body .tc-sidebar-lists .tc-menu-list-subitem a.tc-tiddlylink:hover {
  color: var(--lf-ink);
}

body.tc-body .tc-sidebar-tools-item {
  border-radius: var(--lf-radius-sm);
  padding: 3px 6px;
}

body.tc-body .tc-sidebar-tools-item:hover {
  background: var(--lf-hover);
}

/* ---------- search ---------- */

body.tc-body .tc-sidebar-search .tc-search input,
body.tc-body .tc-search input {
  background: var(--lf-paper);
  border: 1px solid var(--lf-line-strong);
  border-radius: 999px;
  padding: 7px 14px;
  font-family: var(--lf-ui-font);
  font-size: 0.86rem;
  color: var(--lf-ink);
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

body.tc-body .tc-sidebar-search .tc-search input:focus,
body.tc-body .tc-search input:focus {
  outline: none;
  border-color: var(--lf-accent);
  box-shadow: 0 0 0 3px rgba(59, 110, 168, 0.12);
}

body.tc-body .tc-search-results {
  padding-top: 8px;
}

body.tc-body .tc-search-results .tc-list-item.tc-selected {
  background: var(--lf-accent-soft);
  border-radius: var(--lf-radius-sm);
}

/* ---------- dropdowns and popups ---------- */

body.tc-body .tc-block-dropdown,
body.tc-body .tc-drop-down {
  background: var(--lf-paper);
  border: 1px solid var(--lf-line-strong);
  border-radius: var(--lf-radius);
  box-shadow: 0 1px 2px rgba(32, 30, 27, 0.04), 0 10px 28px rgba(32, 30, 27, 0.08);
  padding: 6px;
}

body.tc-body .tc-reveal.tc-popup a.tc-tiddlylink:hover,
body.tc-body .tc-drop-down a:hover {
  background: var(--lf-hover);
  border-radius: var(--lf-radius-sm);
  border-bottom: none;
}

/* ---------- opened-tiddlers bar ---------- */

body.tc-body section.story-backdrop .opened-tiddlers-bar,
body.tc-body section.story-backdrop .opened-tiddlers-bar-container {
  background: var(--lf-page);
  border-bottom: 1px solid var(--lf-line);
}

body.tc-body section.story-backdrop div.opened-tiddlers-bar-tabs button.tc-tab {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0;
  padding: 7px 14px;
  font-size: 0.82rem;
  color: var(--lf-faint);
  max-width: 220px;
  transition: color 120ms ease, background 120ms ease;
}

body.tc-body section.story-backdrop div.opened-tiddlers-bar-tabs button.tc-tab:hover {
  background: var(--lf-hover);
  color: var(--lf-ink);
}

body.tc-body section.story-backdrop div.opened-tiddlers-bar-tabs button.tc-tab.tc-tab-selected {
  background: transparent;
  color: var(--lf-ink-strong);
  font-weight: 550;
  border-bottom-color: var(--lf-accent);
}

body.tc-body .opened-tiddlers-bar-close-button {
  color: var(--lf-faint);
  opacity: 0.6;
}

body.tc-body .opened-tiddlers-bar-close-button:hover {
  color: var(--lf-ink);
  opacity: 1;
}

/* ---------- editor ---------- */

body.tc-body .tc-tiddler-edit-frame textarea.tc-edit-texteditor,
body.tc-body .tc-tiddler-edit-frame input.tc-edit-texteditor,
body.tc-body .tc-tiddler-frame .CodeMirror {
  background: var(--lf-paper);
  border: 1px solid var(--lf-line);
  border-radius: var(--lf-radius-sm);
  font-family: var(--lf-mono-font);
  font-size: 0.92rem;
  line-height: 1.7;
  color: var(--lf-ink);
  padding: 12px 14px;
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

body.tc-body .tc-tiddler-edit-frame textarea.tc-edit-texteditor:hover {
  border-color: var(--lf-line-strong);
}

body.tc-body .tc-tiddler-edit-frame textarea.tc-edit-texteditor:focus {
  outline: none;
  border-color: var(--lf-accent);
  box-shadow: 0 0 0 3px rgba(59, 110, 168, 0.10);
}

body.tc-body .tc-editor-toolbar {
  background: transparent;
  border: none;
  padding: 6px 0;
  margin-bottom: 4px;
}

body.tc-body .tc-editor-toolbar button {
  border-radius: var(--lf-radius-sm);
}

body.tc-body .tc-tiddler-edit-frame .tc-edit-fields {
  font-size: 0.84rem;
}

body.tc-body .tc-tiddler-edit-frame table.tc-edit-fields td {
  border-color: var(--lf-line);
  padding: 5px 7px;
}

body.tc-body select,
body.tc-body .tc-edit-fields select.tc-edit-fieldeditor {
  background: var(--lf-paper);
  border: 1px solid var(--lf-line-strong);
  border-radius: var(--lf-radius-sm);
  font-family: var(--lf-ui-font);
  font-size: 0.85rem;
  padding: 5px 8px;
  color: var(--lf-ink);
}

/* ---------- info panel ---------- */

body.tc-body .tc-tiddler-info {
  background: #faf9f7;
  border: 1px solid var(--lf-line);
  border-radius: var(--lf-radius-sm);
  padding: 14px 16px;
  margin-top: 14px;
}

/* ---------- scrollbars: thin and quiet ---------- */

body.tc-body *::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

body.tc-body *::-webkit-scrollbar-track {
  background: transparent;
}

body.tc-body *::-webkit-scrollbar-thumb {
  background: rgba(55, 53, 47, 0.16);
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: content-box;
}

body.tc-body *::-webkit-scrollbar-thumb:hover {
  background: rgba(55, 53, 47, 0.30);
  background-clip: content-box;
}

/* ---------- narrow windows ---------- */

@media (max-width: 959px) {
  body.tc-body .tc-story-river {
    padding: 20px 14px 30vh;
  }
  body.tc-body .tc-tiddler-frame {
    padding: 22px 20px 26px;
    border-radius: 8px;
  }
}
